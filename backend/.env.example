# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celebrity_booking

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@brassonitent.com
SMTP_USE_TLS=true

# Frontend
FRONTEND_URL=http://localhost:5173

# Oracle Object Storage (S3 호환 API) — 미설정 시 견적 첨부파일은 로컬 uploads/ 저장
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=ap-chuncheon-1
OCI_ACCESS_KEY=
OCI_SECRET_KEY=

# App
APP_NAME=연예인 섭외대행 시스템
DEBUG=true
