# Database
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celebrity_booking
DATABASE_URL=sqlite:///./test.db

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@celebrity-booking.com
SMTP_USE_TLS=true

# Frontend
FRONTEND_URL=http://localhost:5173

# App
APP_NAME=연예인 섭외대행 시스템
DEBUG=true
